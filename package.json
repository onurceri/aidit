{
  "name": "aidit",
  "version": "0.2.0",
  "description": "Local dashboard for managing MCP servers and agent skills across Claude Code, Codex, Cursor, Gemini CLI, VS Code and 25+ AI coding tools. Localhost only, no cloud, no telemetry.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "claude-desktop",
    "cursor",
    "windsurf",
    "dashboard",
    "local-first",
    "localhost",
    "mcp-server",
    "claude-code",
    "codex",
    "gemini-cli",
    "copilot",
    "opencode",
    "kiro",
    "agent-skills",
    "skills"
  ],
  "homepage": "https://github.com/onurceri/aidit#readme",
  "bugs": {
    "url": "https://github.com/onurceri/aidit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onurceri/aidit.git"
  },
  "license": "MIT",
  "author": "Onur Ceri (https://github.com/onurceri)",
  "type": "module",
  "bin": {
    "aidit": "./bin/aidit.js"
  },
  "main": "packages/backend/dist/index.js",
  "files": [
    "bin/",
    "packages/backend/dist/",
    "packages/frontend/dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@9.15.4",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @aidit/backend exec vitest run",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "chokidar": "^3.6.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.0",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "^3.3.0",
    "smol-toml": "^1.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
